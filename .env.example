# ==========================================
# STRIPE TERMINAL DEMO - CONFIGURATION
# Repo: https://github.com/infodukwat-debug/stripe-terminal-js-demo
# ==========================================
# Copier ce fichier vers .env.local et remplir les valeurs
# Ne JAMAIS committer .env* sur GitHub!

# ========== BACKEND ==========
# URL du backend Qnook
REACT_APP_BACKEND_URL=https://qnook-backend-unified.onrender.com

# ========== STRIPE ==========
# Clé publique Stripe (visible, pas de secret ici!)
# Obtenir depuis: https://dashboard.stripe.com/apikeys
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxx

# ========== ENVIRONMENT ==========
REACT_APP_ENV=production
